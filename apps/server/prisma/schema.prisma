generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
  SUPERADMIN
  ROOT
}

enum ChannelVisibility {
  PRIVATE
  PUBLIC
  SEMI_PUBLIC
  DEFAULT
}

enum ChannelMemberRole {
  MEMBER
  MANAGER
}

enum IndexRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  subtitle     String?
  avatarUrl    String?
  passwordHash    String
  hashVersion     String    @default("sha256")
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?
  role         UserRole  @default(MEMBER)
  isBanned     Boolean   @default(false)
  timeoutUntil DateTime?

  memberships     ChannelMember[]
  messages        Message[]
  createdChannels Channel[]       @relation("ChannelCreator")
  reactions       Reaction[]
  mentions        Mention[]
  attachments     Attachment[]
  pinnedMessages  PinnedMessage[]
  voiceSessions   VoiceSession[]
  libraryShelves      LibraryShelf[]
  libraryBooks        LibraryBook[]
  libraryReviews      LibraryReview[]
  libraryBookRequests LibraryBookRequest[]
  gandleResults       GandleResult[]
  channelReads    UserChannelRead[]
  bans            Ban[]              @relation("BanTarget")
  bansIssued      Ban[]              @relation("BanIssuer")
  auditLogs       AuditLog[]
  channelJoinRequests ChannelJoinRequest[]
  recovery        UserRecovery?
  passwordResets  PasswordResetRequest[]
  notifications   Notification[]
}

model Channel {
  id         String            @id @default(cuid())
  name       String
  type       ChannelType       @default(TEXT)
  topic      String?
  createdAt  DateTime          @default(now())
  creatorId  String?
  visibility ChannelVisibility @default(PRIVATE)
  isArchived Boolean           @default(false)

  creator       User?               @relation("ChannelCreator", fields: [creatorId], references: [id])
  members       ChannelMember[]
  messages      Message[]
  pins          PinnedMessage[]
  voiceSessions VoiceSession[]
  channelReads  UserChannelRead[]
  indexRequest  ChannelIndexRequest?
  joinRequests  ChannelJoinRequest[]
}

model ChannelMember {
  userId    String
  channelId String
  joinedAt  DateTime          @default(now())
  role      ChannelMemberRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

// ─── Moderation Models ────────────────────────────────────────────────────────

model Ban {
  id          String    @id @default(cuid())
  userId      String
  issuedById  String
  reason      String?
  bannedAt    DateTime  @default(now())
  unbannedAt  DateTime?
  active      Boolean   @default(true)

  user      User @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy  User @relation("BanIssuer", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  action     String
  targetId   String?
  targetType String?
  meta       Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ─── Channel Lifecycle Models ─────────────────────────────────────────────────

model ChannelIndexRequest {
  id                  String             @id @default(cuid())
  channelId           String             @unique
  requestedById       String
  requestedVisibility ChannelVisibility
  status              IndexRequestStatus @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime           @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model ChannelJoinRequest {
  id           String            @id @default(cuid())
  userId       String
  channelId    String
  message      String?
  status       JoinRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

// ─── Messaging Models ─────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  postNumber Int?     @unique
  content    String
  createdAt  DateTime @default(now())
  editedAt   DateTime?
  isSystem   Boolean  @default(false)

  authorId  String
  channelId String
  replyToId String?

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  reactions   Reaction[]
  mentions    Mention[]
  attachments Attachment[]
  pins        PinnedMessage[]
}

model PinnedMessage {
  id        String   @id @default(cuid())
  pinnedAt  DateTime @default(now())
  messageId String
  channelId String
  pinnedBy  String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinner  User    @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())

  uploaderId String
  messageId  String?

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model Mention {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

// ─── Voice & Presence ─────────────────────────────────────────────────────────

model VoiceSession {
  id        String    @id @default(cuid())
  userId    String
  channelId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model UserChannelRead {
  userId     String
  channelId  String
  lastReadAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

// ─── Games & Features ─────────────────────────────────────────────────────────

model GandleResult {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  guesses   String   // JSON array of guess strings
  solved    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LibraryShelf {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  creatorId   String

  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  books   LibraryBook[]
}

model LibraryBook {
  id         String   @id @default(cuid())
  title      String
  author     String?
  series     String?
  genre      String?
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  coverUrl   String?
  uploadedAt DateTime @default(now())
  uploaderId String
  shelfId    String

  uploader User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  shelf    LibraryShelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  reviews  LibraryReview[]
}

model LibraryReview {
  id         String   @id @default(cuid())
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookId     String
  reviewerId String

  book     LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reviewer User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([bookId, reviewerId])
}

model LibraryBookRequest {
  id          String   @id @default(cuid())
  title       String
  author      String?
  notes       String?
  completed   Boolean  @default(false)
  requestedAt DateTime @default(now())
  requesterId String

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  reaction  String
  createdAt DateTime @default(now())

  userId    String
  messageId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
}

// ─── Recovery & Notifications ─────────────────────────────────────────────────

model UserRecovery {
  userId    String @id
  question1 String
  answer1   String
  question2 String
  answer2   String
  question3 String
  answer3   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetRequest {
  id              String             @id @default(cuid())
  userId          String
  newPasswordHash String
  status          ResetRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  meta      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
