generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  subtitle     String?
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  memberships     ChannelMember[]
  messages        Message[]
  createdChannels Channel[]       @relation("ChannelCreator")
  reactions       Reaction[]
  mentions        Mention[]
  attachments     Attachment[]
  pinnedMessages  PinnedMessage[]
  voiceSessions   VoiceSession[]
  libraryShelves  LibraryShelf[]
  libraryBooks    LibraryBook[]
  gandleResults   GandleResult[]
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      ChannelType @default(TEXT)
  topic     String?
  createdAt DateTime    @default(now())
  creatorId String?

  creator       User?          @relation("ChannelCreator", fields: [creatorId], references: [id])
  members       ChannelMember[]
  messages      Message[]
  pins          PinnedMessage[]
  voiceSessions VoiceSession[]
}

enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
}

model ChannelMember {
  userId    String
  channelId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id         String   @id @default(cuid())
  postNumber Int?     @unique
  content    String
  createdAt  DateTime @default(now())
  editedAt   DateTime?
  isSystem   Boolean  @default(false)

  authorId  String
  channelId String
  replyToId String?

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  reactions   Reaction[]
  mentions    Mention[]
  attachments Attachment[]
  pins        PinnedMessage[]
}

model PinnedMessage {
  id        String   @id @default(cuid())
  pinnedAt  DateTime @default(now())
  messageId String
  channelId String
  pinnedBy  String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinner  User    @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())

  uploaderId String
  messageId  String?

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model Mention {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model VoiceSession {
  id        String    @id @default(cuid())
  userId    String
  channelId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model GandleResult {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  guesses   String   // JSON array of guess strings
  solved    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LibraryShelf {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  creatorId String

  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  books   LibraryBook[]
}

model LibraryBook {
  id         String   @id @default(cuid())
  title      String
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  coverUrl   String?
  uploadedAt DateTime @default(now())
  uploaderId String
  shelfId    String

  uploader User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  shelf    LibraryShelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  reaction  String
  createdAt DateTime @default(now())

  userId    String
  messageId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
}
