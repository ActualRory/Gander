# Copy this to .env and fill in real values before running docker compose up
# Never commit the real .env file

# PostgreSQL password (used by both the postgres container and the server)
POSTGRES_PASSWORD=change-me

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-long-random-string

# LiveKit credentials — must match keys in livekit.prod.yaml
LIVEKIT_API_KEY=prodkey
LIVEKIT_API_SECRET=change-me-livekit-secret
